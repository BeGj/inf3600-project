# Python
**/.venv/
**/__pycache__/
.env

# Training outputs (trained adapters, checkpoints, sample renders — all regenerable).
# Bare pattern: matches a dir named `outputs/` at any depth (notebooks/outputs/, etc.).
outputs/

# Node
**/node_modules/
frontend/dist/

# Model weights (large; ship via volume/release). Keep the manifest + README.
backend/models/**/*.safetensors
backend/models/**/*.bin
# Datasets. Keep large generated datasets ignored; allow only curated small sets.
datasets/*
!datasets/.gitignore
!datasets/README.md
!datasets/small_house_set/
!datasets/small_tree_set/
!datasets/houses/.gitkeep
!datasets/trees/.gitkeep
